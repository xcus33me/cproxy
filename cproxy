#!/usr/bin/env bash
# Source entrypoint. Release bundles include bin/cproxy; source builds are cached.
set -euo pipefail
ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
ui="$ROOT/bin/cproxy"
if [[ ! -x "$ui" ]]; then
    if ! command -v go >/dev/null; then
        if command -v pacman >/dev/null && [[ -t 0 ]]; then
            echo 'Для первого запуска из исходников нужен Go. Установить через pacman? [y/N]'
            read -r answer
            [[ "$answer" == y ]] || exit 130
            sudo pacman -S --needed go
        else echo 'Установите Go 1.25.8+ или скачайте готовую сборку cproxy из Releases.' >&2; exit 1; fi
    fi
    mkdir -p -- "$ROOT/.build"
    ui="$ROOT/.build/cproxy"
    [[ -x "$ui" ]] || echo 'Первый запуск: собираем интерфейс cproxy…'
    (cd -- "$ROOT" && go build -trimpath -o "$ui.new.$$" ./cmd/cproxy)
    mv -f -- "$ui.new.$$" "$ui"
fi
export CPROXY_SOURCE_DIR="$ROOT"
exec "$ui" "$@"
