#!/usr/bin/env bash
set -euo pipefail
HERE=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source=linux/common.sh
source "$HERE/common.sh"
usage() { echo 'proxyctl status|start|stop|restart|test|logs|config|browser|unlock|lock'; }
command_name=${1:-help}; shift || true
case "$command_name" in
    help|--help|-h) usage; exit 0 ;;
    status|start|stop|restart|test|logs|config|browser|unlock|lock) ;;
    *) usage >&2; exit 2 ;;
esac
if [[ "$command_name" == logs && ${1:-} == --once && $# == 1 ]]; then exec journalctl --user -u "$SP_UNIT" -n 60 --no-pager; fi
[[ $# == 0 ]] || { fail 'Эта команда не принимает аргументы.'; exit 2; }
if [[ "$command_name" == logs ]]; then exec journalctl --user -u "$SP_UNIT" -n 60 -f; fi
if [[ "$command_name" == config ]]; then
    printf '%s\nРедактирование параметров: install.sh --reconfigure. Проверка: sing-box check -c "%s"\n' "$SP_CONFIG" "$SP_CONFIG"
    exit 0
fi
if [[ "$command_name" == stop ]]; then
    if ! owned || ! grep -q '^# Managed by cproxy' "${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/$SP_UNIT"; then fail 'Unit не принадлежит cproxy.'; exit 1; fi
    exec systemctl --user stop "$SP_UNIT"
fi
load_config
case "$command_name" in
    status)
        result=0
        if command -v sing-box >/dev/null; then sing-box version | head -1; else echo 'sing-box: отсутствует'; result=1; fi
        printf 'Конфиг: %s\n' "$SP_CONFIG"
        if systemctl --user is-active --quiet "$SP_UNIT"; then echo 'Сервис: active'; else echo 'Сервис: stopped'; result=1; fi
        if tcp_ready 127.0.0.1 "$SP_PORT"; then echo "Порт $SP_PORT: доступен"; else echo "Порт $SP_PORT: закрыт"; result=1; fi
        if tcp_ready "$SP_SERVER" "$SP_SSH_PORT"; then echo 'VPS SSH TCP: доступен (это не проверка аутентификации)'; else echo 'VPS SSH TCP: недоступен'; result=1; fi
        if command -v ip >/dev/null; then
            echo 'Текущий маршрут до VPS (Amnezia может влиять на него):'
            address=$(timeout 5 getent ahostsv4 "$SP_SERVER" | awk 'NR==1 {print $1}') || true
            [[ -z "${address:-}" ]] || ip route get "$address" || true
        fi
        exit "$result" ;;
    start|restart)
        need sing-box
        sing-box check -c "$SP_CONFIG"
        systemctl --user "$command_name" "$SP_UNIT"
        wait_ready ;;
    stop) systemctl --user stop "$SP_UNIT" ;;
    unlock)
        owned || { fail 'Нет управляемой установки.'; exit 1; }
        [[ $(jq -r '.key_mode' "$SP_SETTINGS") == session ]] || { fail 'Используется unattended key.'; exit 1; }
        systemctl --user stop "$SP_UNIT"
        unlock_key "$(jq -r '.encrypted_key_path' "$SP_SETTINGS")" "$(jq -r '.outbounds[0].private_key_path' "$SP_CONFIG")"
        sing-box check -c "$SP_CONFIG"
        systemctl --user start "$SP_UNIT"; wait_ready ;;
    lock)
        owned || exit 1
        [[ $(jq -r '.key_mode' "$SP_SETTINGS") == session ]] || { fail 'Используется unattended key.'; exit 1; }
        systemctl --user stop "$SP_UNIT"
        rm -f -- "$XDG_RUNTIME_DIR/selective-proxy/session.key" ;;
    browser)
        verify_egress >/dev/null
        need firefox
        profile="$SP_DIR/firefox-Claude"
        mkdir -p -- "$profile"; chmod 700 "$profile"
        if [[ -e "$profile/user.js" ]] && ! head -1 "$profile/user.js" | grep -qx '// Managed by cproxy'; then
            fail 'user.js не принадлежит cproxy. Сохраните его вне выделенного профиля.'; exit 1
        fi
        cat > "$profile/user.js" <<PREFS
// Managed by cproxy
user_pref("network.proxy.type", 1);
user_pref("network.proxy.http", "");
user_pref("network.proxy.http_port", 0);
user_pref("network.proxy.ssl", "");
user_pref("network.proxy.ssl_port", 0);
user_pref("network.proxy.share_proxy_settings", false);
user_pref("network.proxy.socks", "127.0.0.1");
user_pref("network.proxy.socks_port", $SP_PORT);
user_pref("network.proxy.socks_version", 5);
user_pref("network.proxy.socks_remote_dns", true);
user_pref("network.proxy.socks5_remote_dns", true);
user_pref("network.proxy.no_proxies_on", "");
user_pref("network.proxy.failover_direct", false);
user_pref("network.proxy.allow_bypass", false);
user_pref("network.trr.mode", 5);
user_pref("media.peerconnection.enabled", false);
user_pref("network.http.http3.enable", false);
user_pref("network.dns.disablePrefetch", true);
user_pref("network.prefetch-next", false);
user_pref("browser.urlbar.speculativeConnect.enabled", false);
user_pref("network.predictor.enabled", false);
PREFS
        firefox --no-remote --new-instance --profile "$profile" https://claude.ai >/dev/null 2>&1 &
        disown
        echo 'Открываем отдельный Firefox для Claude.' ;;
    test)
        failed=0
        echo 'IPv4 (HTTPS, HTTP CONNECT и SOCKS5 с remote DNS):'
        direct=$(fetch '' https://api4.ipify.org) || direct=''
        http=$(fetch "$SP_PROXY" https://api4.ipify.org) || http=''
        socks=$(fetch "socks5h://127.0.0.1:$SP_PORT" https://api4.ipify.org) || socks=''
        printf '  direct: %s\n  HTTP:   %s\n  SOCKS5: %s\n' "${direct:-ERROR}" "${http:-ERROR}" "${socks:-ERROR}"
        valid_ip "$http" && valid_ip "$socks" && [[ "$http" == "$socks" ]] || failed=1
        verify_egress || failed=1
        [[ -n "$direct" ]] || echo 'Прямой интернет недоступен; работающий proxy проверен отдельно.'
        [[ -z "$direct" || "$direct" != "$http" ]] || echo 'Обычный и proxy IP совпадают: это возможно при активном VPN и само по себе не ошибка.'
        echo 'IPv6 (цель api6, транспорт до loopback остаётся IPv4):'
        http6=''; socks6=''
        for kind in direct HTTP SOCKS5; do
            proxy=''; [[ "$kind" != HTTP ]] || proxy="$SP_PROXY"
            [[ "$kind" != SOCKS5 ]] || proxy="socks5h://127.0.0.1:$SP_PORT"
            if v6=$(fetch "$proxy" https://api6.ipify.org 2>/dev/null) && valid_ip "$v6"; then
                printf '  %s: %s\n' "$kind" "$v6"
                [[ "$kind" != HTTP ]] || http6=$v6
                [[ "$kind" != SOCKS5 ]] || socks6=$v6
            else printf '  %s: IPv6 недоступен\n' "$kind"; fi
        done
        if [[ -n "$http6" && -n "$socks6" && "$http6" != "$socks6" ]]; then
            echo 'HTTP и SOCKS5 IPv6 отличаются; проверьте выходы VPS.'; failed=1
        fi
        echo 'Fail-closed: маршрут проверен; для проверки обрыва используйте tests/integration.sh --outage.'
        if [[ -f "$SP_SETTINGS" ]]; then
            while IFS= read -r url; do
                [[ -n "$url" ]] || continue
                if fetch '' "$url" >/dev/null && fetch "$SP_PROXY" "$url" >/dev/null; then
                    echo 'Локальная тестовая цель: доступна напрямую и через proxy'
                else echo 'Локальная тестовая цель: ошибка'; failed=1; fi
            done < <(jq -r '.local_tests[]?' "$SP_SETTINGS")
        fi
        exit "$failed" ;;
esac
